{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "checkJs": false,
    "baseUrl": ".",
    "paths": {
      "@/components/*": ["src/components/*"],
      "@/hooks/*": ["src/hooks/*"],
      "@/pages/*": ["src/pages/*"],
      "@/styles/*": ["src/styles/*"],
      "@/lib/*": ["src/lib/*"],
      "@/images/*": ["public/images/*"],
      "@/fonts/*": ["public/fonts/*"],
    }
  }
}
